# ═══════════════════════════════════════════════════════════════════════
# Luna Camp brains — HONEST policy
# ═══════════════════════════════════════════════════════════════════════
# Coding this site with Grok/xAI in chat does NOT put xAI on your visitors.
# Paid Grok for the live site is OFF unless you deliberately opt in.
#
# Live (telephanti.com / Render): free cloud keys OR offline witty templates.
# Ollama is for YOUR PC only — never required for public visitors.
# ═══════════════════════════════════════════════════════════════════════

# ── LIVE / Render (copy these to Render env — not home Ollama force) ──
# LUNA_CLOUD=1
# LUNA_LLM_BACKEND=free
# LUNA_FREE_BRAINS=1
# LUNA_FORCE_OLLAMA=0
# PREFER_OLLAMA=0
# LUNA_ALLOW_GROK=0
# LUNA_DISABLE_GROK=1
# LUNA_GROK_FALLBACK=0
# Pick at least one free cloud key (you own the free tier account):
# GROQ_API_KEY=           # https://console.groq.com
# GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_API_KEY=     # https://openrouter.ai  (use :free models)
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# GEMINI_API_KEY=         # optional Google free tier

# ── HOME PC (local only — optional Ollama) ────────────────────────────
LUNA_LLM_BACKEND=ollama
LUNA_FORCE_OLLAMA=0
PREFER_OLLAMA=1
LUNA_FREE_BRAINS=1
LUNA_ALLOW_GROK=0
LUNA_DISABLE_GROK=1
LUNA_GROK_FALLBACK=0
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Token budgets for free backends
FREE_MAX_TOKENS=360
FREE_MAX_TOKENS_AMBIENT=160
FREE_MAX_TOKENS_CONVERSE=280

# Paid xAI — ONLY if you want YOUR credits on the site (not default)
# LUNA_ALLOW_GROK=1
# LUNA_DISABLE_GROK=0
# XAI_API_KEY=
# GROK_MODEL=grok-4-fast-non-reasoning

TTS_VOICE=en-US-AriaNeural
LUNA_HOST=0.0.0.0

# ── Free minds (recommended) ─────────────────────────────────────────
# I (Grok/xAI in chat) cannot put my API key on your server.
# Free compute options that DO work:

# 1) Local Ollama — free on YOUR PC (most efficient, no cloud tokens)
LUNA_LLM_BACKEND=ollama
LUNA_FORCE_OLLAMA=1
PREFER_OLLAMA=1
LUNA_FREE_BRAINS=1
LUNA_ALLOW_GROK=0
LUNA_DISABLE_GROK=1
LUNA_GROK_FALLBACK=0
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# 2) Optional FREE cloud (sign up yourself — free tiers, not xAI)
# Groq free: https://console.groq.com  → API keys → paste:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
#
# OpenRouter free models: https://openrouter.ai  → keys → paste:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
# Gemini free (optional):
# GEMINI_API_KEY=

# Token budgets for free backends (keep small = efficient)
FREE_MAX_TOKENS=360
FREE_MAX_TOKENS_AMBIENT=160
FREE_MAX_TOKENS_CONVERSE=280

# 3) Paid Grok/xAI — only if you want to spend YOUR credits
# LUNA_ALLOW_GROK=1
# LUNA_DISABLE_GROK=0
# XAI_API_KEY=
# GROK_MODEL=grok-4-fast-non-reasoning

TTS_VOICE=en-US-AriaNeural
LUNA_HOST=0.0.0.0
